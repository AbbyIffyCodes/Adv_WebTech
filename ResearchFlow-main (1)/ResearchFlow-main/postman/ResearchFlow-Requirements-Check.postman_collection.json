{
  "info": {
    "name": "ResearchFlow - Requirements Check",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Set coordinatorPassword privately, then run 01-18. Uses a separate demo account and opportunity. Existing groups, projects, supervision and files are preserved. New passwords use bcrypt. Successful login upgrades compatible legacy Argon2 hashes. Groups and projects CRUD are demonstrated in their original collections."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:5001",
      "type": "string"
    },
    {
      "key": "coordinatorEmail",
      "value": "coordinator@example.com",
      "type": "string"
    },
    {
      "key": "coordinatorPassword",
      "value": "",
      "type": "string"
    },
    {
      "key": "supervisorEmail",
      "value": "supervisor@example.com",
      "type": "string"
    },
    {
      "key": "supervisorPassword",
      "value": "Supervisor@12345",
      "type": "string"
    },
    {
      "key": "demoPassword",
      "value": "CrudDemo@12345",
      "type": "string"
    },
    {
      "key": "coordinatorToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "supervisorToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "demoToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "demoEmail",
      "value": "",
      "type": "string"
    },
    {
      "key": "demoId",
      "value": "",
      "type": "string"
    },
    {
      "key": "demoOpportunityId",
      "value": "",
      "type": "string"
    },
    {
      "key": "demoDeadline",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 Coordinator login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{coordinatorEmail}}\",\n  \"password\": \"{{coordinatorPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected 200',()=>pm.response.to.have.status(200));",
              "if(pm.response.code<300)pm.collectionVariables.set('coordinatorToken',pm.response.json().accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Supervisor login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{supervisorEmail}}\",\n  \"password\": \"{{supervisorPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected 200',()=>pm.response.to.have.status(200));",
              "if(pm.response.code<300)pm.collectionVariables.set('supervisorToken',pm.response.json().accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Register separate demo account",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/accounts",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Tahmid CRUD Demo\",\n  \"email\": \"{{demoEmail}}\",\n  \"password\": \"{{demoPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('demoEmail','crud.'+pm.variables.replaceIn('{{$guid}}')+'@example.com');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected 201',()=>pm.response.to.have.status(201));",
              "if(pm.response.code<300)pm.collectionVariables.set('demoId',pm.response.json().user.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Demo account login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{demoEmail}}\",\n  \"password\": \"{{demoPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected 200',()=>pm.response.to.have.status(200));",
              "if(pm.response.code<300)pm.collectionVariables.set('demoToken',pm.response.json().accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Read own account",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/accounts/{{demoId}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{demoToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected 200',()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Update own name",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/accounts/{{demoId}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{demoToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Tahmid Updated Demo\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected 200',()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Duplicate email rejected and update rolled back",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/accounts/{{demoId}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{demoToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Must Roll Back\",\n  \"email\": \"{{coordinatorEmail}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected 409',()=>pm.response.to.have.status(409));"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Verify previous name remains",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/accounts/{{demoId}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{demoToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected 200',()=>pm.response.to.have.status(200));",
              "pm.test('Update rolled back',()=>pm.expect(pm.response.json().fullName).to.eql('Tahmid Updated Demo'));"
            ]
          }
        }
      ]
    },
    {
      "name": "09 Coordinator lists accounts",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/accounts?page=1&limit=5",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{coordinatorToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected 200',()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "10 Student cannot list private accounts",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/accounts",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{demoToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected 403',()=>pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    },
    {
      "name": "11 Paginated group directory",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/groups?page=1&limit=5",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{demoToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected 200',()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "12 Create separate opportunity for deletion test",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/opportunities",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{supervisorToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"CRUD Demonstration Opportunity\",\n  \"description\": \"Temporary post for testing the delete endpoint.\",\n  \"criteria\": \"Interest in research\",\n  \"places\": 1,\n  \"deadline\": \"{{demoDeadline}}\",\n  \"areaTags\": [\n    \"NLP\"\n  ],\n  \"requiredSkills\": [],\n  \"preferredSkills\": []\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('demoDeadline',new Date(Date.now()+30*86400000).toISOString());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected 201',()=>pm.response.to.have.status(201));",
              "if(pm.response.code<300)pm.collectionVariables.set('demoOpportunityId',pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "13 Delete unused opportunity",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/opportunities/{{demoOpportunityId}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{supervisorToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected 200',()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "14 Deleted opportunity is missing",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/opportunities/{{demoOpportunityId}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{supervisorToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected 404',()=>pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    },
    {
      "name": "15 Coordinator deactivates demo account",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/accounts/{{demoId}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{coordinatorToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected 200',()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "16 Old token stops working",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/auth/me",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{demoToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected 401',()=>pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "17 Deactivated login is rejected",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{demoEmail}}\",\n  \"password\": \"{{demoPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected 401',()=>pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "18 Coordinator reads retained account record",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/accounts/{{demoId}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{coordinatorToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected 200',()=>pm.response.to.have.status(200));",
              "pm.test('Account inactive',()=>pm.expect(pm.response.json().isActive).to.eql(false));"
            ]
          }
        }
      ]
    }
  ]
}
