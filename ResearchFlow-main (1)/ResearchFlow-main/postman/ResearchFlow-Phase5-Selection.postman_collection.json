    {
      "name": "3. Optional end and demonstrate supervisor-led selection",
      "item": [
        {
          "name": "24 End current supervision - releases places",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/selection/supervisions/{{supervisionId}}/end",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{leaderToken}}",
