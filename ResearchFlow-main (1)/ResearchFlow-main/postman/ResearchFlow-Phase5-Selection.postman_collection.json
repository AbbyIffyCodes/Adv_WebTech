  "item": [
    {
      "name": "1. Application, offer and explicit confirmation",
      "item": [
        {
          "name": "01 Supervisor login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{supervisorEmail}}\",\n  \"password\": \"{{supervisorPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected 200',()=>pm.response.to.have.status(200));",
                  "if(pm.response.code>=200&&pm.response.code<300)pm.collectionVariables.set('supervisorToken',pm.response.json().accessToken);",
                  "if(pm.response.code>=200&&pm.response.code<300)pm.collectionVariables.set('supervisorId',pm.response.json().user.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "02 Find my open NLP opportunity",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/opportunities/mine?researchInterest=NLP",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{supervisorToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected 200',()=>pm.response.to.have.status(200));",
                  "const p=pm.response.json().items.find(p=>p.acceptingApplications);pm.test('Open opportunity exists',()=>pm.expect(p).not.to.eql(undefined));if(p)pm.collectionVariables.set('opportunityId',p.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "03 Group leader login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{leaderEmail}}\",\n  \"password\": \"{{leaderPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected 200',()=>pm.response.to.have.status(200));",
                  "if(pm.response.code>=200&&pm.response.code<300)pm.collectionVariables.set('leaderToken',pm.response.json().accessToken);",
                  "if(pm.response.code>=200&&pm.response.code<300)pm.collectionVariables.set('leaderId',pm.response.json().user.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "04 Read my published project",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/projects/mine",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{leaderToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected 200',()=>pm.response.to.have.status(200));",
                  "const p=pm.response.json().project;pm.test('Project exists and summary is published',()=>{pm.expect(p).not.to.eql(null);pm.expect(p.publishedAt).not.to.eql(null);});if(p){pm.collectionVariables.set('projectId',p.id);pm.collectionVariables.set('groupId',p.groupId);}"
                ]
              }
            }
          ]
        },
        {
          "name": "05 Ensure Python is in my actual profile skills",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/profiles/{{leaderId}}/tags",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{leaderToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"skills\": [\n    \"Python\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected 201',()=>pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "06 Read supervisor capacity before confirmation",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/selection/capacity/{{supervisorId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{leaderToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected 200',()=>pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "07 Supervisor has no document access before consent",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/projects/{{projectId}}/document-access",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{supervisorToken}}",
