                  "pm.test('Document access false',()=>pm.expect(pm.response.json().allowed).to.eql(false));"
                ]
              }
            }
          ]
        },
        {
          "name": "08 Leader applies to the opportunity",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
