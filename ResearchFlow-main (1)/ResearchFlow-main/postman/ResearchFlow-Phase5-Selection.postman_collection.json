          ]
        },
        {
          "name": "17 Read decision and permission activity",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/projects/{{projectId}}/activity",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
