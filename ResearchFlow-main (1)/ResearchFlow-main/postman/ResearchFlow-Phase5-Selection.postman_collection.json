                {
                  "key": "token",
                  "value": "{{leaderToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"projectId\": \"{{projectId}}\",\n  \"supervisorId\": \"{{supervisorId}}\",\n  \"opportunityId\": \"{{opportunityId}}\",\n  \"statement\": \"Our group would like to research Bangla abstract classification. We have Python skills and are interested in NLP.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected 201',()=>pm.response.to.have.status(201));",
                  "if(pm.response.code>=200&&pm.response.code<300)pm.collectionVariables.set('requestId',pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "09 Supervisor offers supervision",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/selection/requests/{{requestId}}/offer",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{supervisorToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected 200',()=>pm.response.to.have.status(200));",
                  "pm.test('Offer awaits leader confirmation',()=>pm.expect(pm.response.json().status).to.eql('offered'));"
                ]
              }
            }
          ]
        },
        {
          "name": "10 Offer alone gives no document access",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/projects/{{projectId}}/document-access",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{supervisorToken}}",
                  "type": "string"
                }
