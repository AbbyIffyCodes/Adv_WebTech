            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected 200',()=>pm.response.to.have.status(200));",
                  "pm.test('Document access false',()=>pm.expect(pm.response.json().allowed).to.eql(false));"
                ]
              }
            }
          ]
        },
        {
          "name": "11 Reject confirmation without sharing consent",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/selection/requests/{{requestId}}/confirm",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{leaderToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"shareFullProposal\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected 400',()=>pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "12 Leader confirms and explicitly grants access",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/selection/requests/{{requestId}}/confirm",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{leaderToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"shareFullProposal\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected 200',()=>pm.response.to.have.status(200));",
                  "if(pm.response.code>=200&&pm.response.code<300)pm.collectionVariables.set('supervisionId',pm.response.json().supervision.id);",
                  "if(pm.response.code>=200&&pm.response.code<300)pm.collectionVariables.set('supervisorGrantId',pm.response.json().accessGrant.id);",
                  "pm.test('Student places reserved',()=>pm.expect(pm.response.json().supervision.reservedPlaces).to.be.above(0));"
                ]
              }
            }
          ]
        },
        {
          "name": "13 Read reserved and remaining supervisor places",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/selection/capacity/{{supervisorId}}",
            "auth": {
