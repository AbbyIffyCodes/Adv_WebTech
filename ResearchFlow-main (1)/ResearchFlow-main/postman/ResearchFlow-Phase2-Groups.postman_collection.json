{
  "info": {
    "name": "ResearchFlow Phase 2 - Groups",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Separate from Phase 1. Set local credentials in collection variables. Run 01–14 manually in order on first use. Skip existing account/group creation on reruns. Invitations must be accepted by their named recipient. The optional cleanup folder transfers leadership, leaves and archives your DEMO group. Read backend/docs/GROUPS.md before rerunning. These passwords are fake sample values, never production credentials."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:5001",
      "type": "string"
    },
    {
      "key": "leaderEmail",
      "value": "naimul.phase1@example.com",
      "type": "string"
    },
    {
      "key": "leaderPassword",
      "value": "Sample@12345",
      "type": "string"
    },
    {
      "key": "memberEmail",
      "value": "groupmate.phase2@example.com",
      "type": "string"
    },
    {
      "key": "memberPassword",
      "value": "Groupmate@12345",
      "type": "string"
    },
    {
      "key": "leaderToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "memberToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "leaderId",
      "value": "",
      "type": "string"
    },
    {
      "key": "memberId",
      "value": "",
      "type": "string"
    },
    {
      "key": "groupId",
      "value": "",
      "type": "string"
    },
    {
      "key": "invitationId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Create and test a demo group",
      "item": [
        {
          "name": "01 Leader login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{leaderEmail}}\",\n  \"password\": \"{{leaderPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected status 200', () => pm.response.to.have.status(200));",
                  "if (pm.response.code >= 200 && pm.response.code < 300) pm.collectionVariables.set('leaderToken', pm.response.json().accessToken);",
                  "if (pm.response.code >= 200 && pm.response.code < 300) pm.collectionVariables.set('leaderId', pm.response.json().user.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "02 Check my current group",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/groups/mine",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{leaderToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected status 200', () => pm.response.to.have.status(200));",
                  "const group=pm.response.json().group; if(group) pm.collectionVariables.set('groupId',group.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "03 Create group (skip if 02 returned a group)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/groups",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{leaderToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"ResearchFlow AI Team\",\n  \"description\": \"Research collaboration demo\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected status 201', () => pm.response.to.have.status(201));",
                  "if (pm.response.code >= 200 && pm.response.code < 300) pm.collectionVariables.set('groupId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "04 Register demo member (skip if already registered)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/accounts",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Demo Group Member\",\n  \"email\": \"{{memberEmail}}\",\n  \"password\": \"{{memberPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected status 201', () => pm.response.to.have.status(201));",
                  "if (pm.response.code >= 200 && pm.response.code < 300) pm.collectionVariables.set('memberId', pm.response.json().user.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "05 Member login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{memberEmail}}\",\n  \"password\": \"{{memberPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected status 200', () => pm.response.to.have.status(200));",
                  "if (pm.response.code >= 200 && pm.response.code < 300) pm.collectionVariables.set('memberToken', pm.response.json().accessToken);",
                  "if (pm.response.code >= 200 && pm.response.code < 300) pm.collectionVariables.set('memberId', pm.response.json().user.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "06 Leader invites member",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/groups/{{groupId}}/invitations",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{leaderToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"inviteeId\": \"{{memberId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected status 201', () => pm.response.to.have.status(201));",
                  "if (pm.response.code >= 200 && pm.response.code < 300) pm.collectionVariables.set('invitationId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "07 Member reads own invitations",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/groups/invitations/me",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{memberToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "08 Member accepts invitation",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/groups/invitations/{{invitationId}}/accept",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{memberToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "09 Read group with two members",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/groups/{{groupId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{leaderToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Two members joined',()=>pm.expect(pm.response.json().memberCount).to.eql(2));"
                ]
              }
            }
          ]
        },
        {
          "name": "10 Leader edits group",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/groups/{{groupId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{leaderToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"ResearchFlow NLP Team\",\n  \"description\": \"Our research group\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "11 Member cannot edit leader settings",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/groups/{{groupId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{memberToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Unauthorized rename\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected status 403', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "12 Member cannot create a second group",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/groups",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{memberToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Second group\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected status 409', () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "13 Reject empty group name",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/groups/{{groupId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{leaderToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected status 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "14 Leader reads invitation history",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/groups/{{groupId}}/invitations",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{leaderToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. OPTIONAL cleanup - changes memberships and archives group",
      "item": [
        {
          "name": "15 Transfer leadership to member",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/groups/{{groupId}}/leader",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{leaderToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"leaderId\": \"{{memberId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "16 Former leader leaves",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/groups/{{groupId}}/leave",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{leaderToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "17 New leader archives the group",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/groups/{{groupId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{memberToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "18 Member has no active group",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/groups/mine",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{memberToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Membership released',()=>pm.expect(pm.response.json().group).to.eql(null));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
