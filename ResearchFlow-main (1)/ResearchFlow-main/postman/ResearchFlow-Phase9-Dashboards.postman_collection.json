                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected 200',()=>pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "12 Verify my unread inbox is empty",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/notifications?unread=true",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{leaderToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected 200',()=>pm.response.to.have.status(200));",
                  "pm.test('My notices read',()=>pm.expect(pm.response.json().unread).to.eql(0));"
                ]
              }
            }
          ]
        },
        {
          "name": "13 Supervisor cannot mark the students notice read",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": "{{baseUrl}}/notifications/{{notificationId}}/read",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{supervisorToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected 404',()=>pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "14 Supervisor has a separate private inbox",
          "request": {
            "method": "GET",
            "header": [],
