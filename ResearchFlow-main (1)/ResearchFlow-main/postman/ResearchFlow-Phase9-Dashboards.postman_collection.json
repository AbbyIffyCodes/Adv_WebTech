                ]
              }
            }
          ]
        },
        {
          "name": "11 Mark all my notices read",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": "{{baseUrl}}/notifications/read-all",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{leaderToken}}",
