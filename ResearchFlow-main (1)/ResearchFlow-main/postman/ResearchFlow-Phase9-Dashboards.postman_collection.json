            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected 200',()=>pm.response.to.have.status(200));",
                  "pm.test('Coordinator scope',()=>pm.expect(pm.response.json().role).to.eql('coordinator'));"
                ]
              }
            }
          ]
        },
        {
          "name": "07 Read my private inbox",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/notifications",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{leaderToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected 200',()=>pm.response.to.have.status(200));",
                  "const n=pm.response.json().items[0];pm.test('Existing workflow generated a notice',()=>pm.expect(n).not.to.eql(undefined));if(n)pm.collectionVariables.set('notificationId',n.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "08 Mark my notice read",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": "{{baseUrl}}/notifications/{{notificationId}}/read",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{leaderToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected 200',()=>pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "09 Read only unread notices",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/notifications?unread=true",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
