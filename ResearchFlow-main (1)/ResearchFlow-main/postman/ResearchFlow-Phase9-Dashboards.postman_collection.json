{
  "info": {
    "name": "ResearchFlow Phase 9 - Dashboards and Alerts",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Set existing coordinatorPassword privately in Variables before request 03. Run 01–15 manually. All requests return 200 except 13 which deliberately returns 404. No pairing, proposal, milestone or support data is changed. The migration seeds generic notices for up to 1000 recent events from the past seven days, so the existing demonstration has an inbox. 07 captures notificationId; if no notices exist, first complete a normal workflow action by another participant. Read state belongs only to each user. These are backend JSON dashboards; the React frontend is next term."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:5001",
      "type": "string"
    },
    {
      "key": "leaderEmail",
      "value": "naimul.phase1@example.com",
      "type": "string"
    },
    {
      "key": "leaderPassword",
      "value": "Sample@12345",
      "type": "string"
    },
    {
      "key": "supervisorEmail",
      "value": "supervisor@example.com",
      "type": "string"
    },
    {
      "key": "supervisorPassword",
      "value": "Supervisor@12345",
      "type": "string"
    },
    {
      "key": "coordinatorEmail",
      "value": "coordinator@example.com",
      "type": "string"
    },
    {
      "key": "coordinatorPassword",
      "value": "",
      "type": "string"
    },
    {
      "key": "leaderToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "supervisorToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "coordinatorToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "notificationId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Three role dashboards and private in-app alerts",
      "item": [
        {
          "name": "01 Leader login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{leaderEmail}}\",\n  \"password\": \"{{leaderPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected 200',()=>pm.response.to.have.status(200));",
                  "if(pm.response.code>=200&&pm.response.code<300)pm.collectionVariables.set('leaderToken',pm.response.json().accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "02 Supervisor login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{supervisorEmail}}\",\n  \"password\": \"{{supervisorPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected 200',()=>pm.response.to.have.status(200));",
                  "if(pm.response.code>=200&&pm.response.code<300)pm.collectionVariables.set('supervisorToken',pm.response.json().accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "03 Coordinator login - set local password first",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{coordinatorEmail}}\",\n  \"password\": \"{{coordinatorPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected 200',()=>pm.response.to.have.status(200));",
                  "if(pm.response.code>=200&&pm.response.code<300)pm.collectionVariables.set('coordinatorToken',pm.response.json().accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "04 Student dashboard",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/dashboard",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{leaderToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected 200',()=>pm.response.to.have.status(200));",
                  "pm.test('Student scope',()=>pm.expect(pm.response.json().role).to.eql('student'));"
                ]
              }
            }
          ]
        },
        {
          "name": "05 Supervisor dashboard",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/dashboard",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{supervisorToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected 200',()=>pm.response.to.have.status(200));",
                  "pm.test('Supervisor scope',()=>pm.expect(pm.response.json().role).to.eql('supervisor'));"
                ]
              }
            }
          ]
        },
        {
          "name": "06 Coordinator dashboard",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/dashboard",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{coordinatorToken}}",
                  "type": "string"
                }
