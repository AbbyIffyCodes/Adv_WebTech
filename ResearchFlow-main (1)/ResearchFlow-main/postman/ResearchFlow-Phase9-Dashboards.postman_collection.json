        },
        {
          "name": "15 Coordinator reads paginated administrative project summaries",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/dashboard/projects?page=1&limit=20",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{coordinatorToken}}",
                  "type": "string"
                }
              ]
