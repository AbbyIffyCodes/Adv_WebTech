                ]
              }
            }
          ]
        },
        {
          "name": "10 Refresh my due and overdue deadline notices",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/notifications/refresh",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
