# Run pnpm run setup:local to generate a private JWT secret.
PORT=5001
HOST=127.0.0.1
NODE_ENV=development
APP_ENV=local
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=replace_with_your_local_postgres_password
DB_DATABASE=researchflow
JWT_BEARER_SECRET=
JWT_TTL=3600
SELECTION_RESPONSE_HOURS=168
PRIVATE_UPLOAD_DIR=uploads/private
UPLOAD_MAX_FILE_MB=5
UPLOAD_MAX_FILES=5
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
FRONTEND_URL=http://localhost:5173
# Queue support is not needed for the first phase.
ENABLE_QUEUE=false
ENABLE_DEADLINE_ALERTS=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Used only by the one-time coordinator bootstrap command. Clear after use.
COORDINATOR_NAME=
COORDINATOR_EMAIL=
COORDINATOR_PASSWORD=
